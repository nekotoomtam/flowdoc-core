{
  "schemaVersion": 1,
  "nodeModelVersion": 4,
  "templateId": "tpl-binding-text",
  "docKey": "binding-text",
  "version": 1,
  "name": "Bound text PDF",
  "book": {
    "page": {
      "size": "A4",
      "orientation": "portrait",
      "margin": {
        "top": {
          "value": 20,
          "unit": "mm"
        },
        "right": {
          "value": 20,
          "unit": "mm"
        },
        "bottom": {
          "value": 20,
          "unit": "mm"
        },
        "left": {
          "value": 20,
          "unit": "mm"
        }
      }
    },
    "contentSlot": "body"
  },
  "globalSchema": {
    "type": "object",
    "fields": {
      "projectName": {
        "type": "string",
        "required": true,
        "allowEmpty": false,
        "label": "ชื่อโครงการ"
      }
    }
  },
  "styles": {
    "body": {
      "fontFamilyKey": "sarabun",
      "fontWeight": "normal",
      "fontSize": {
        "value": 12,
        "unit": "pt"
      },
      "lineHeightPt": 20
    }
  },
  "formats": {
    "note": {
      "label": "ข้อความประกอบหัวข้อ",
      "inputSchema": {
        "type": "object",
        "fields": {
          "text": {
            "type": "string",
            "required": true
          }
        }
      },
      "fragment": {
        "rootIds": [
          "note"
        ],
        "nodes": {
          "note": {
            "id": "note",
            "type": "text-block",
            "role": {
              "role": "paragraph"
            },
            "props": {
              "textStyleId": "body",
              "sizing": {
                "mode": "content"
              }
            },
            "children": [
              {
                "id": "prefix",
                "type": "text",
                "text": "โครงการ "
              },
              {
                "id": "project",
                "type": "field-ref",
                "scope": "global",
                "key": "projectName"
              },
              {
                "id": "separator",
                "type": "text",
                "text": ": "
              },
              {
                "id": "note-value",
                "type": "field-ref",
                "scope": "local",
                "key": "text"
              }
            ]
          }
        }
      },
      "repeats": []
    },
    "remark": {
      "label": "ข้อความประกอบหัวข้อ",
      "inputSchema": {
        "type": "object",
        "fields": {
          "text": {
            "type": "string",
            "default": "ไม่ได้ระบุหมายเหตุ"
          }
        }
      },
      "fragment": {
        "rootIds": [
          "note"
        ],
        "nodes": {
          "note": {
            "id": "note",
            "type": "text-block",
            "role": {
              "role": "paragraph"
            },
            "props": {
              "textStyleId": "body",
              "sizing": {
                "mode": "content"
              }
            },
            "children": [
              {
                "id": "label",
                "type": "text",
                "text": "หมายเหตุ: "
              },
              {
                "id": "value",
                "type": "field-ref",
                "scope": "local",
                "key": "text"
              }
            ]
          }
        }
      },
      "repeats": []
    }
  },
  "examples": [
    {
      "name": "normal",
      "request": {
        "docKey": "binding-text",
        "version": 1,
        "data": {
          "projectName": "FlowDoc ทดสอบการแทนตัวแปร"
        },
        "content": [
          {
            "format": "note",
            "data": {
              "text": "ขอบเขตการทำงาน\nสร้างเอกสารจากโครงและข้อมูล"
            }
          },
          {
            "format": "remark",
            "data": {}
          },
          {
            "format": "note",
            "data": {
              "text": "รายการสุดท้ายใช้โครงเดิมและข้อมูลคนละชุด"
            }
          }
        ]
      }
    }
  ]
}
