{
  "schemaVersion": 1,
  "nodeModelVersion": 18,
  "templateId": "tpl-binding-text",
  "docKey": "binding-text",
  "version": 1,
  "name": "Bound text PDF",
  "book": {
    "contentSlot": "body",
    "defaultPageLayoutId": "normal"
  },
  "globalSchema": {
    "type": "object",
    "fields": {
      "projectName": {
        "type": "string",
        "required": true,
        "allowEmpty": false,
        "label": "ชื่อโครงการ"
      }
    }
  },
  "styles": {
    "body": {
      "fontFamilyKey": "sarabun",
      "fontWeight": "normal",
      "fontSize": {
        "value": 12,
        "unit": "pt"
      },
      "lineHeightPt": 20
    }
  },
  "examples": [],
  "pageLayouts": {
    "normal": {
      "page": {
        "size": "A4",
        "orientation": "portrait",
        "margin": {
          "top": {
            "value": 20,
            "unit": "mm"
          },
          "right": {
            "value": 20,
            "unit": "mm"
          },
          "bottom": {
            "value": 20,
            "unit": "mm"
          },
          "left": {
            "value": 20,
            "unit": "mm"
          }
        }
      }
    }
  },
  "sections": [
    {
      "id": "main",
      "key": "main",
      "source": {
        "kind": "authored",
        "fragment": {
          "rootIds": [
            "area"
          ],
          "nodes": {
            "area": {
              "id": "area",
              "type": "area",
              "props": {
                "areaId": "main-details"
              }
            }
          }
        },
        "repeats": []
      },
      "inputSchema": {
        "type": "object",
        "fields": {
          "details": {
            "type": "area",
            "areaId": "main-details"
          }
        }
      },
      "formats": {}
    }
  ],
  "areaFormats": {
    "note": {
      "label": "ข้อความประกอบหัวข้อ",
      "inputSchema": {
        "type": "object",
        "fields": {
          "text": {
            "type": "string",
            "required": true
          }
        }
      },
      "fragment": {
        "rootIds": [
          "note"
        ],
        "nodes": {
          "note": {
            "id": "note",
            "type": "text-block",
            "role": {
              "role": "paragraph"
            },
            "props": {
              "textStyleId": "body",
              "sizing": {
                "mode": "content"
              }
            },
            "children": [
              {
                "id": "prefix",
                "type": "text",
                "text": "โครงการ "
              },
              {
                "id": "project",
                "type": "field-ref",
                "scope": "global",
                "key": "projectName"
              },
              {
                "id": "separator",
                "type": "text",
                "text": ": "
              },
              {
                "id": "note-value",
                "type": "field-ref",
                "scope": "local",
                "key": "text"
              }
            ]
          }
        }
      },
      "repeats": [],
      "key": "note",
      "ownerAreaId": "main-details"
    },
    "remark": {
      "label": "ข้อความประกอบหัวข้อ",
      "inputSchema": {
        "type": "object",
        "fields": {
          "text": {
            "type": "string",
            "default": "ไม่ได้ระบุหมายเหตุ"
          }
        }
      },
      "fragment": {
        "rootIds": [
          "note"
        ],
        "nodes": {
          "note": {
            "id": "note",
            "type": "text-block",
            "role": {
              "role": "paragraph"
            },
            "props": {
              "textStyleId": "body",
              "sizing": {
                "mode": "content"
              }
            },
            "children": [
              {
                "id": "label",
                "type": "text",
                "text": "หมายเหตุ: "
              },
              {
                "id": "value",
                "type": "field-ref",
                "scope": "local",
                "key": "text"
              }
            ]
          }
        }
      },
      "repeats": [],
      "key": "remark",
      "ownerAreaId": "main-details"
    }
  }
}
